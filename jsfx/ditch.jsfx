desc: Ditch Shifter
//tags: processing pitch
//author: Dwight Ivany
//next steps 5 & 6 after committing to a default after testing
//add a simplest delay

slider1:7<-20,20,1>Pitch (cents)
slider5:20<0.05,50,0.5>Overlap Size (ms)
slider6:1<0,1,1{No,Yes}>Filter

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
  bufsize = (50 * 0.001 * srate) | 0; // Hardcoded window size of 50 ms
  ext_tail_size = bufsize * 2;
  xfade = 100;
  bufloc0 = 10000;
  bufloc1 = bufloc0 + bufsize + 1000;

  buffer0 = bufloc0;
  buffer1 = bufloc1;
  bufdiff = bufloc1 - bufloc0;
  denorm = 10^-20;

  // Pointers for separate processing
  v0_left = bufloc0;
  v0_right = bufloc0;

@slider
  filter = slider6 > 0.5;

  xfade = (slider5 * 0.001 * srate) | 0;
  xfade > bufsize * 0.5 ? xfade = bufsize * 0.5;

  pitch_left = 2^((-slider1 * 0.01) / 12);
  pitch_right = 2^((slider1 * 0.01) / 12);

@sample
  // Write current input to buffer
  buffer0[0] = spl0; 
  buffer0[bufdiff] = spl1;

  // Process left channel
  iv0_left = v0_left | 0; frac_left = v0_left - iv0_left;
  iv0_next_left = iv0_left + 1 < (bufloc0 + bufsize) ? iv0_left + 1 : bufloc0;
  ren_left = (iv0_left[0] * (1 - frac_left) + iv0_next_left[0] * frac_left);

  ((v0_left += pitch_left) >= (bufloc0 + bufsize)) ? v0_left -= bufsize;

  // Process right channel
  iv0_right = v0_right | 0; frac_right = v0_right - iv0_right;
  iv0_next_right = iv0_right + 1 < (bufloc0 + bufsize) ? iv0_right + 1 : bufloc0;
  ren_right = (iv0_right[0] * (1 - frac_right) + iv0_next_right[0] * frac_right);

  ((v0_right += pitch_right) >= (bufloc0 + bufsize)) ? v0_right -= bufsize;

  // Apply filter if enabled
  filter ? (
      ren_left = a1 * ren_left + a2 * h01 + a3 * h02 - b1 * h03 - b2 * h04 + denorm;
      ren_right = a1 * ren_right + a2 * h11 + a3 * h12 - b1 * h13 - b2 * h14 + denorm;

      h02 = h01; h01 = ren_left;
      h12 = h11; h11 = ren_right;
      h04 = h03; h03 = ren_left;
      h14 = h13; h13 = ren_right;
  );

  // Output the processed signals
  spl0 = ren_left; // Left channel output (negative pitch)
  spl1 = ren_right; // Right channel output (positive pitch)

  // Increment buffer pointer
  ((buffer0 += 1) >= (bufloc0 + bufsize)) ? buffer0 -= bufsize;
